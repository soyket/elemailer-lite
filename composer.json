{
    "name": "elemailer/elemailer-lite",
    "description": "Dev tooling for Elemailer Lite",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint:syntax": "find . -name '*.php' -not -path '*/vendor/*' -not -path './lib/*' -not -path '*/node_modules/*' -print0 | xargs -0 -n1 php -l > /dev/null",
        "lint:phpcs": "phpcs",
        "lint:phpcs:changed": "git diff --name-only --diff-filter=ACMRT HEAD -- '*.php' | grep -v '^helpers/vendor/' | xargs -r phpcs",
        "test:unit": "phpunit --testsuite unit",
        "test": "phpunit"
    }
}
